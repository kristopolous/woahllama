/version/
/probe/*.txt
/probe/*_probe/
/res*

# Large and regenerable
/survey.db
/survey.db-shm
/survey.db-wal
*.csv.gz
/pipeline/dbip-*.csv*

# Python
__pycache__/
*.pyc

# Scratch
/scratchpad/

# private wider survey (host-level; never publish)
/full-survey-private.json
