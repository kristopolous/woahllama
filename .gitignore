# Upstream scanners: their commit history IS the dataset. Cloned by setup.sh.
/Awesome-Ollama-Server/
/ollamalist/
/OllamaSpider/
# upstream ollama, cloned for its release tag dates (pipeline/ollama_releases.py)
/ollama/

# Private raw data — never published. The results are here; the host lists are not.
/version/
/probe/*.txt
/probe/*_probe/
/res*

# Large and regenerable
/survey.db
# geo placements carried across a full re-ingest; keyed by server URL,
# so it holds real IPs and must never be published
/pipeline/geo_keep.db
# derived from the private probe: its key space is model names observed on
# real hosts, and some of those "names" are real IP addresses
/pipeline/model_releases.json
/survey.db-shm
/survey.db-wal
*.csv.gz
/pipeline/dbip-*.csv*

# Python
__pycache__/
*.pyc

# Scratch
/scratchpad/

# private wider survey (host-level; never publish)
/full-survey-private.json
/history/
/ollama-hosts.json
/ollama-working.json
/ollama-notworking.json
/fofa/
/tmp/
survey.db.bak
/graflex/
/convo.txt
